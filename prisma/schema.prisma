generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  VEGETABLE // ผัก
  FRUIT // ผลไม้
  OTHER // อื่นๆ
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String? // รายละเอียดเกี่ยวกับผัก/ผลไม้ (ประโยชน์, วิธีเก็บรักษา) สำหรับให้ AI ค้นข้อมูล
  price       Float // ราคา
  unit        String // หน่วยขาย เช่น "กิโลกรัม", "กำ", "แพ็ค", "ขีด"
  category    Category // ประเภท เช่น VEGETABLE, FRUIT
  inStock     Boolean  @default(true) // มีของพร้อมขายหรือไม่
  stockQty    Float    @default(0) // จำนวนคงเหลือ (ถ้าอยากเช็คสต็อกแบบละเอียด)
  imageUrl    String? // รูปภาพของผักผลไม้

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


